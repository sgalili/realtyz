# Copy to .env locally; configure the same names in Railway/Render.
IMPORT_WORKER_ENABLED=false
TORAFF_IMPORT_API_URL=
IMPORT_WORKER_SHARED_SECRET=
BRIGHT_DATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
IMPORT_WORKER_ID=toraff-worker-1
WORKER_CONCURRENCY=4
WORKER_REQUEST_INTERVAL_MS=1000
WORKER_SOURCE_TIMEOUT_MS=45000
WORKER_POLL_INTERVAL_MS=5000
# No SUPABASE_SERVICE_ROLE_KEY or database password: Cloud retains privileged access.
# TORAFF_IMPORT_API_URL is the protected Cloud machine endpoint, not the website.